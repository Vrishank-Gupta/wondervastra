# ---- Core ------------------------------------------------------------------
# Public URL of the site. Used in emails, WhatsApp messages and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local file database. For hosting without a disk, use Turso:
#   DATABASE_URL=libsql://your-db.turso.io  and  DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/vastravibe.db
DATABASE_AUTH_TOKEN=

# First admin login, used by `npm run db:seed` and `npm run admin:create`.
# If ADMIN_PASSWORD is blank a random one is generated and printed once.
ADMIN_EMAIL=owner@vastravibe.in
ADMIN_PASSWORD=

# ---- Razorpay (dashboard.razorpay.com -> Account & Settings -> API Keys) -----
# Blank = simulated payments in development; online payment is OFF in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://your-site/api/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (resend.com) ------------------------------------------------------
# Blank = emails are recorded in Admin -> Notifications but not sent.
RESEND_API_KEY=
EMAIL_FROM=WonderVastra <orders@wondervastra.in>

# ---- WhatsApp Cloud API (developers.facebook.com) -----------------------------
# Blank = messages are recorded, and you get one-tap "send on WhatsApp" buttons.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en

# ---- Images -------------------------------------------------------------------
# Default: saved to UPLOAD_DIR on disk. Set Cloudinary for serverless hosting.
UPLOAD_DIR=./data/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Scheduled jobs ------------------------------------------------------------
# Call GET /api/cron with header "Authorization: Bearer <CRON_SECRET>" every 15 min.
CRON_SECRET=
