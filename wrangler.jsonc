{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wondervastra",
  "main": "cf-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "wondervastra" }],
  // Non-secret settings. Secrets (database token, Razorpay, Cloudinary…) are set with `wrangler secret put`.
  // The shop's own domain (DNS on Cloudflare). www redirects are handled by the same worker.
  "workers_dev": true,
  "routes": [
    { "pattern": "wondervastra.in", "custom_domain": true },
    { "pattern": "www.wondervastra.in", "custom_domain": true }
  ],
  "vars": { "CF_BUILD": "1", "NEXT_PUBLIC_SITE_URL": "https://wondervastra.in", "CATALOG_CACHE_SECONDS": "20" },
  // Run next to the Turso database in Mumbai: pages make several queries, so each round trip counts.
  "placement": { "mode": "targeted", "region": "aws:ap-south-1" },
  // Every 15 minutes: expires unpaid orders, syncs Delhivery tracking. 9 am IST: the owner's summary email (src/app/api/cron/route.ts).
  "triggers": { "crons": ["*/15 * * * *", "30 3 * * *"] },
  // The deployed version id: store pages cached at the edge are keyed by it (see cf-worker.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
