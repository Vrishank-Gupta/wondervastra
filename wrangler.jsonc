{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wondervastra",
  "main": "cf-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "wondervastra" }],
  // Non-secret settings. Secrets (database token, Razorpay, Cloudinary…) are set with `wrangler secret put`.
  "vars": { "CF_BUILD": "1" },
  // Expires unpaid orders and releases their stock (see src/app/api/cron/route.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
